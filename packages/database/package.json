{
  "name": "@spinova/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./query": {
      "types": "./src/query.ts",
      "import": "./src/query.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "env:load": "dotenv -e ../../.env --",
    "db:push": "pnpm env:load drizzle-kit push",
    "db:generate": "pnpm env:load drizzle-kit generate",
    "db:migrate": "pnpm env:load drizzle-kit migrate",
    "db:seed": "pnpm env:load node src/seed.ts",
    "db:studio": "pnpm env:load drizzle-kit studio"
  },
  "dependencies": {
    "@spinova/env": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@spinova/typescript-config": "workspace:*",
    "@types/node": "^20.19.9",
    "@types/pg": "^8.16.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2"
  }
}
