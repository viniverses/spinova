{
  "name": "@spinova/api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "env:load": "dotenv -e ../../.env --",
    "dev": "pnpm env:load tsx watch src/local.ts",
    "build": "tsup",
    "start": "node dist/local.js",
    "check-types": "tsc --noEmit",
    "test": "pnpm env:load vitest run",
    "test:watch": "pnpm env:load vitest"
  },
  "dependencies": {
    "@elysia/node": "^1.4.6",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@sinclair/typebox": "^0.34.52",
    "@spinova/auth": "workspace:*",
    "@spinova/database": "workspace:*",
    "@spinova/env": "workspace:*",
    "elysia": "^1.4.30",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@spinova/eslint-config": "workspace:*",
    "@spinova/typescript-config": "workspace:*",
    "@types/node": "^20.19.43",
    "dotenv-cli": "^8.0.0",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
